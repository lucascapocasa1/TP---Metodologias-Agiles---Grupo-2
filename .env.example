# Copiá este archivo a `.env` y reemplazá por TU conexión de Supabase/PostgreSQL.
# El archivo `.env` está gitignored: NUNCA se sube al repo (contiene la contraseña).
# Si no definís DATABASE_URL, el proyecto usa SQLite automáticamente.
DATABASE_URL=postgresql://usuario:contraseña@host.supabase.co:5432/postgres