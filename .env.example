# Copiar a `.env` y completar con los datos reales del local.
# `.env` NO se sube al repositorio (está en .gitignore).

# --- Base de datos ---
# PostgreSQL local. Si falta, el proyecto cae a SQLite (solo para demo).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db_kiosco

# --- Catálogo público y WhatsApp (HU-13) ---
# Nombre del kiosco que se muestra en la vitrina pública.
KIOSCO_NOMBRE=Kiosco de Barrio
# WhatsApp del local, formato internacional, solo dígitos (sin + ni espacios).
# Ejemplo Argentina (celular de Buenos Aires): 5491155554444
KIOSCO_WHATSAPP=5491155554444

# --- Mercado Pago: cobro con QR (opcional) ---
# Access Token de PRUEBA de tu aplicación en
# https://www.mercadopago.com.ar/developers/panel/app (Credenciales de prueba).
# Sin esto, la caja cobra con QR en modo de prueba (pago simulado, sin plata real).
MP_ACCESS_TOKEN=
# URL pública al webhook /ventas/mercadopago/webhook/ (ej. con ngrok). Opcional.
MP_NOTIFICATION_URL=
